#include <string>
#include <vector>
#include <algorithm>

class Solution {
public:
    std::string convert(const std::string &s, int numRows) {
        if (numRows <= 1) return s;
        int n = (int)s.size();
        int cycle = 2 * (numRows - 1);
        int fullCycles = n / cycle;
        int rem = n % cycle;
        int cols = fullCycles * (numRows - 1);
        if (rem > 0) {
            if (rem <= numRows) cols += 1;
            else cols += 1 + (rem - numRows);
        }

        std::vector<std::vector<char>> matrix(numRows, std::vector<char>(cols, '\0'));
        int idx = 0;
        int col = 0;
        while (idx < n && col < cols) {
            // vertical down
            for (int r = 0; r < numRows && idx < n; ++r) {
                matrix[r][col] = s[idx++];
            }
            // diagonal up
            for (int k = 1; k <= numRows - 2 && idx < n; ++k) {
                if (col + k < cols)
                    matrix[numRows - 1 - k][col + k] = s[idx++];
            }
            col += (numRows - 1);
        }

        std::string sol;
        sol.reserve(n);
        for (int r = 0; r < numRows; ++r) {
            for (int c = 0; c < cols; ++c) {
                if (matrix[r][c] != '\0') sol.push_back(matrix[r][c]);
            }
        }
        return sol;
    }
};